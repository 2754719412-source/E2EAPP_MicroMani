+    dataset_dir = tmp_path / "dataset"
+    (dataset_dir / "meta").mkdir(parents=True)
+    (dataset_dir / "meta" / "info.json").write_text(
+        json.dumps({"format": "lerobot-v3-native", "dataContract": {"version": "future.v9"}}),
